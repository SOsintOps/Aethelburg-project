# Aethelburg environment variables
# Copy to .env and change the values. Never commit .env.
# Companies House keys are better entered in the app (7. Settings, saved in the
# database) or kept in the OS keyring:
#   python -m keyring set aethelburg ch_api_key
#   python -m keyring set aethelburg ch_streaming_key
# CH_API_KEY / CH_STREAMING_KEY set here win over both.

# --- PostgreSQL (optional backend; SQLite is the default) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aethelburg
POSTGRES_USER=aethelburg
POSTGRES_PASSWORD=change_this_password

# --- Nominatim (on-demand geocoding) ---
# Start: docker compose --profile geocoding up nominatim
NOMINATIM_URL=http://127.0.0.1:8080/nominatim
NOMINATIM_PBF_URL=https://download.geofabrik.de/europe/great-britain-latest.osm.pbf
NOMINATIM_REPLICATION_URL=https://planet.openstreetmap.org/replication/hour/
NOMINATIM_PASSWORD=change_this_password

# --- Companies House API ---
# Free keys from https://developer.company-information.service.gov.uk/
CH_API_KEY=
CH_STREAMING_KEY=

# --- OpenSanctions ---
# Optional: raises the API rate limit
OPENSANCTIONS_API_KEY=

# --- App ---
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

# --- Data folder ---
# Leave unset to use the folder chosen with `python -m src.main data location`
# (default C:\AethelburgData). Setting it here overrides that choice.
# DATA_DIR=C:\AethelburgData
# ONSPD_PATH=C:\AethelburgData\onspd\ONSPD_latest.csv
