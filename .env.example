# Aethelburg — variabili di ambiente
# Copia in .env e modifica i valori
# NON committare .env

# --- PostgreSQL ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aethelburg
POSTGRES_USER=aethelburg
POSTGRES_PASSWORD=cambia_questa_password

# --- Nominatim (geocoding on-demand) ---
# Avvio: docker-compose --profile geocoding up nominatim
NOMINATIM_URL=http://127.0.0.1:8080/nominatim
NOMINATIM_PBF_URL=https://download.geofabrik.de/europe/great-britain-latest.osm.pbf
NOMINATIM_REPLICATION_URL=https://planet.openstreetmap.org/replication/hour/
NOMINATIM_PASSWORD=cambia_questa_password

# --- Companies House API ---
# Richiede registrazione su developer.companieshouse.gov.uk
CH_API_KEY=
CH_STREAMING_KEY=

# --- OpenSanctions ---
# Opzionale: aumenta rate limit per API
OPENSANCTIONS_API_KEY=

# --- App ---
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

# --- Percorsi dati locali ---
DATA_DIR=./dati
ONSPD_PATH=./dati/onspd/ONSPD_latest.csv
